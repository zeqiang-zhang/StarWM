+
+
+class NoisyShapeAdapter:
+  """Adapt gymnasium-style NoisyShape envs (5-tuple step, dict obs with bool keys)
+  to the IsoDream gym-style 4-tuple interface with image-only obs dict."""
+
+  def __init__(self, env):
+    self._env = env
+
+  def __getattr__(self, name):
+    return getattr(self._env, name)
+
+  @property
+  def observation_space(self):
+    return gym.spaces.Dict({
+        'image': gym.spaces.Box(0, 255, self._env._size + (3,), dtype=np.uint8),
+    })
+
+  @property
+  def action_space(self):
+    return self._env.action_space
+
+  def _strip_obs(self, obs):
+    return {'image': obs['image']}
+
+  def reset(self, **kwargs):
+    out = self._env.reset(**kwargs)
+    if isinstance(out, tuple):
+      obs, _info = out
+    else:
+      obs = out
+    return self._strip_obs(obs)
+
+  def step(self, action):
+    out = self._env.step(action)
+    if len(out) == 5:
+      obs, reward, terminated, truncated, info = out
+      done = bool(terminated or truncated)
+    else:
+      obs, reward, done, info = out
+    info = dict(info)
+    info.setdefault('discount', np.array(1.0, dtype=np.float32))
+    return self._strip_obs(obs), float(reward), done, info
