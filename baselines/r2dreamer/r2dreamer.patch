+class FiveToFourTupleStep(gym.Wrapper):
+    """Adapt a gymnasium-style env (``step`` -> obs, reward, terminated,
+    truncated, info; ``reset`` -> obs) to the 4-tuple API used here."""
+
+    def step(self, action):
+        obs, reward, terminated, truncated, info = self.env.step(action)
+        return obs, reward, bool(terminated or truncated), info
+
+    def reset(self):
         return self.env.reset()
 
 
